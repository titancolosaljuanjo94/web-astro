---
// pages/blog/[id].astro
// Página de detalle de un post. El [id] en el nombre del archivo es el
// nombre del .md sin extensión (ver src/content/blog/README.md).
// - `seoTitle` (opcional) reemplaza el <title>; si falta: "title | Juanjo Quintana".
// - `faq` (opcional) se pinta como "Preguntas frecuentes" y genera el schema FAQPage.
// - `cover` + `coverAlt` (recomendados): foto de portada; también es la og:image.
//   Si un post publicado no tiene portada, el build muestra un aviso.
import Layout from "../../layouts/Layout.astro";
import { Image, getImage } from "astro:assets";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
	const posts = await getCollection("blog", ({ data }) => !data.draft);
	const sinPortada = posts.filter((p) => !p.data.cover).map((p) => p.id);
	if (sinPortada.length) {
		console.warn(
			`\n⚠️  Falta foto de portada (cover + coverAlt) en: ${sinPortada.join(", ")}\n` +
				"   Agrégala en el frontmatter, p. ej. cover: ./img/<slug>.jpg\n",
		);
	}
	return posts.map((post) => ({
		params: { id: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, seoTitle, description, pubDate, updatedDate, faq, cover, coverAlt } = post.data;

// Versión 1200 px de la portada para redes sociales y schema.
const ogImage = cover ? (await getImage({ src: cover, width: 1200, format: "jpg" })).src : undefined;

const pageTitle = seoTitle ?? `${title} | Juanjo Quintana`;
const url = new URL(`/blog/${post.id}/`, Astro.site).toString();

const author = {
	"@type": "Person",
	name: "Juanjo Quintana",
	url: new URL("/", Astro.site).toString(),
};

const schema: Record<string, unknown>[] = [
	{
		"@context": "https://schema.org",
		"@type": "BlogPosting",
		headline: title,
		description,
		datePublished: pubDate.toISOString(),
		dateModified: (updatedDate ?? pubDate).toISOString(),
		author,
		publisher: author,
		mainEntityOfPage: url,
		inLanguage: "es-PE",
		...(ogImage && { image: new URL(ogImage, Astro.site).toString() }),
	},
];

if (faq?.length) {
	schema.push({
		"@context": "https://schema.org",
		"@type": "FAQPage",
		mainEntity: faq.map(({ q, a }) => ({
			"@type": "Question",
			name: q,
			acceptedAnswer: { "@type": "Answer", text: a },
		})),
	});
}
---

<Layout title={pageTitle} description={description} image={ogImage} ogType="article">
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
	<article class="container post">
		<a href="/blog/" class="back-link">&larr; Volver al blog</a>
		<h1>{title}</h1>
		<p class="post-date">
			Publicado el {pubDate.toLocaleDateString("es-AR")}
			{updatedDate && (
				<> · Actualizado el {updatedDate.toLocaleDateString("es-AR")}</>
			)}
		</p>
		{cover && (
			<Image
				src={cover}
				alt={coverAlt ?? ""}
				widths={[480, 800, 1200]}
				sizes="(max-width: 42rem) 100vw, 42rem"
				class="post-cover"
				loading="eager"
				fetchpriority="high"
			/>
		)}
		<div class="post-content">
			<Content />
		</div>
		{faq?.length && (
			<section class="post-faq">
				<h2>Preguntas frecuentes</h2>
				{faq.map(({ q, a }) => (
					<>
						<h3>{q}</h3>
						<p>{a}</p>
					</>
				))}
			</section>
		)}
	</article>
</Layout>

<style>
	.post {
		padding-block: 3rem;
		max-width: 42rem;
	}

	.back-link {
		display: inline-block;
		margin-bottom: 1.5rem;
		font-size: 0.9rem;
		text-decoration: none;
	}

	.post-date {
		color: var(--color-text-muted);
		font-size: 0.9rem;
	}

	.post-cover {
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: var(--radius);
		margin-top: 1.5rem;
	}

	.post-content {
		margin-top: 2rem;
	}

	.post-content :global(h2),
	.post-faq h2 {
		margin-top: 2.5rem;
	}

	.post-content :global(h3),
	.post-faq h3 {
		margin-top: 1.75rem;
	}

	.post-content :global(ul),
	.post-content :global(ol) {
		padding-left: 1.5rem;
		margin-bottom: 1em;
	}

	.post-content :global(li) {
		margin-bottom: 0.35em;
	}

	.post-content :global(table) {
		width: 100%;
		border-collapse: collapse;
		margin: 1.5rem 0;
		font-size: 0.95rem;
		display: block;
		overflow-x: auto;
	}

	.post-content :global(th),
	.post-content :global(td) {
		border: 1px solid var(--color-border);
		padding: 0.6rem 0.75rem;
		text-align: left;
		vertical-align: top;
	}

	.post-content :global(th) {
		background-color: var(--color-bg-muted);
		color: var(--color-primary);
	}

	.post-content :global(blockquote) {
		margin: 1.5rem 0;
		padding: 0.75rem 1rem;
		border-left: 4px solid var(--color-accent);
		background-color: var(--color-bg-muted);
	}

	.post-content :global(blockquote p:last-child) {
		margin-bottom: 0;
	}

	.post-faq {
		margin-top: 3rem;
		border-top: 1px solid var(--color-border);
	}
</style>
