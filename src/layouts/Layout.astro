---
// Layout.astro
// Layout base de todas las páginas del sitio. Cada página pasa un
// `title` y una `description` propios (importantes para SEO) y su
// contenido va dentro del <slot />.
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
// El sitio usa URLs sin slash final (trailingSlash: 'never'), salvo /blog/,
// que sí lo lleva.
const isBlogPath = Astro.url.pathname.startsWith("/blog");
const canonicalPath =
	isBlogPath && !Astro.url.pathname.endsWith("/")
		? `${Astro.url.pathname}/`
		: Astro.url.pathname;
const canonicalURL = new URL(canonicalPath, Astro.site);
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
		<link rel="canonical" href={canonicalURL} />
	</head>
	<body>
		<Nav />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
