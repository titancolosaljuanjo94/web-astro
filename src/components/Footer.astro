---
// Footer.astro
// Pie de página simple: nombre, año actual (automático) y email de contacto.
// Incluye el link a /privacidad (lo pide la verificación de Google).
const siteName = "Juanjo Quintana";
const contactEmail = "juanjosequintanasantillan@gmail.com";
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container footer-inner">
		<p>&copy; {year} {siteName}. Todos los derechos reservados.</p>
		<nav class="footer-links">
			<a href="/privacidad" data-footer-privacy>Política de privacidad</a>
			<a href="/terminos" data-footer-terms>Condiciones del servicio</a>
			<a href={`mailto:${contactEmail}`} data-footer-contact>{contactEmail}</a>
		</nav>
		<p class="footer-projects">
			Mi proyecto:
			<a href="https://financieroperuano.nom.pe/" data-footer-project>Financiero Peruano: noticias y simuladores financieros del Perú</a>
		</p>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--color-border);
		background-color: var(--color-bg-muted);
		margin-top: 4rem;
	}

	.footer-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding-block: 1.5rem;
		font-size: 0.9rem;
		color: var(--color-text-muted);
	}

	.footer-inner p {
		margin: 0;
	}

	.footer-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.footer-projects {
		flex-basis: 100%;
	}

	.footer-inner a {
		color: var(--color-text-muted);
	}
</style>
